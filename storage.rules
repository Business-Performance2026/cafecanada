rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /shops/{shopId}/{allImages=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == shopId;
    }

    // Global category icon images, managed by the admin only.
    // ⚠️ Replace ADMIN_UID_HERE with the UID of YOUR admin account in the
    // CANADA Firebase project (Authentication → Users → copy User UID).
    match /categoryIcons/{allImages=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == "ADMIN_UID_HERE";
    }

    // Bank-transfer receipt images uploaded by customers (no login).
    // Create-only: a customer can never overwrite or delete a receipt.
    match /shops/{shopId}/receipts/{fileName} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.uid == shopId;
    }
  }
}
